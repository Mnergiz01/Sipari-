rules_version = '2';

// İki giriş modu: Google Sign-In (OWNER_UID) ya da PIN ile Anonymous Auth
// Anon auth zayıf koruma sağlar; tradeoff bilinçli kabul edildi.
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwnerOrAnon() {
      return request.auth != null
        && (request.auth.uid == "3EzOiIRTtGRxPVMJDvyJ9uG1NtW2"
            || request.auth.token.firebase.sign_in_provider == "anonymous");
    }
    match /{document=**} {
      allow read, write: if isOwnerOrAnon();
    }
  }
}
